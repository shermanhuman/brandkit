<div class="hero min-h-64">
  <div class="hero-overlay"></div>
  <div class="hero-content" id="hero-section">
    <a href="#hero-cta" data-testid="hero-title">Start</a>
    <.input field={@form[:title]} name="hero-title" />
  </div>
</div>
<.input :if={@n < 3} name="hero-title" />
<.button icon="lucide-trash">Delete</.button>
