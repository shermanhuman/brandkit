{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Fixture base brand: day roles.",
  "color": {
    "$type": "color",
    "bg": {
      "$value": "{palette.ink-50}"
    },
    "surface": {
