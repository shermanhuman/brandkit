  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": [
        "Atkinson Hyperlegible",
        "system-ui",
        "sans-serif"
      ],
      "$description": "Body and UI text."
    },
    "mono": {
      "$value": [
        "Fira Mono",
        "ui-monospace",
        "monospace"
      ],
      "$description": "Code, figures in tables."
    }
  },
  "weight": {
    "$type": "fontWeight",
    "regular": {
      "$value": 400
    },
    "bold": {
      "$value": 700
    }
  },
  "type": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 2.25,
          "unit": "rem"
        },
        "fontWeight": "{weight.bold}",
        "letterSpacing": {
          "value": -0.02,
          "unit": "rem"
        },
        "lineHeight": 1.1
      },
      "$description": "Page titles."
    },
    "heading": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 1.5,
          "unit": "rem"
        },
        "fontWeight": "{weight.bold}",
        "letterSpacing": {
          "value": 0,
          "unit": "rem"
        },
        "lineHeight": 1.25
      },
      "$description": "Section headings."
    },
    "body": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": "{weight.regular}",
        "letterSpacing": {
          "value": 0,
          "unit": "rem"
        },
        "lineHeight": 1.5
      },
      "$description": "Running text."
    },
    "small": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": "{weight.regular}",
        "letterSpacing": {
          "value": 0.01,
          "unit": "rem"
        },
        "lineHeight": 1.4
      },
      "$description": "Captions and table cells."
    },
    "code": {
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": "{weight.regular}",
        "letterSpacing": {
          "value": 0,
          "unit": "rem"
        },
        "lineHeight": 1.5
      },
      "$description": "Code and IDs."
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "The spacing scale.",
    "1": {
      "$value": {
        "value": 0.25,
        "unit": "rem"
      }
    },
    "2": {
      "$value": {
        "value": 0.5,
        "unit": "rem"
      }
    },
    "3": {
      "$value": {
        "value": 0.75,
        "unit": "rem"
      }
    },
    "4": {
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    },
    "6": {
      "$value": {
        "value": 1.5,
        "unit": "rem"
      }
    },
    "8": {
      "$value": {
        "value": 2,
        "unit": "rem"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "The radius scale.",
    "selector": {
      "$value": {
        "value": 0.25,
        "unit": "rem"
      },
      "$description": "Checkboxes, toggles, badges."
    },
    "field": {
      "$value": {
        "value": 0.375,
        "unit": "rem"
      },
      "$description": "Buttons and inputs."
    },
    "box": {
      "$value": {
        "value": 0.75,
        "unit": "rem"
      },
      "$description": "Cards, modals, alerts."
    }
  },
  "size": {
    "$type": "dimension",
    "selector": {
      "$value": {
        "value": 0.25,
        "unit": "rem"
      }
    },
    "field": {
      "$value": {
        "value": 0.25,
        "unit": "rem"
      }
    }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "$value": {
        "value": 1,
        "unit": "px"
      }
    }
  },
  "motion": {
    "fast": {
      "$type": "duration",
      "$value": {
        "value": 120,
        "unit": "ms"
      }
    },
    "ease": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    }
  }
}
